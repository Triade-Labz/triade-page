# Copie este arquivo para ".env" (que NÃO vai para o Git) e preencha.
# Na hospedagem (Vercel), cadastre as mesmas variáveis VITE_ em
# Project Settings → Environment Variables, para Production e Preview.

# Supabase → Project Settings → API
# URL do projeto, ex.: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Chave PUBLICÁVEL (sb_publishable_...) ou a antiga "anon" (eyJ...).
# Ela pode ficar no navegador: o banco só deixa o site INSERIR leads.
# NUNCA coloque aqui a chave secret / service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: abre o CRM em modo demonstração (leads de exemplo, nada é salvo)
# mesmo sem o Supabase configurado. Em "npm run dev" o modo demo já é automático.
# VITE_CRM_DEMO=true

# ---------------------------------------------------------------------
# SÓ PARA OS SCRIPTS DO COMPUTADOR (npm run db ...). Nunca use VITE_ aqui:
# o prefixo VITE_ coloca o valor dentro do site, visível para qualquer um.
# ---------------------------------------------------------------------

# Supabase → Connect → Direct connection (ou Session pooler, se sua rede não tiver IPv6).
# Caracteres especiais da senha precisam ser codificados: / vira %2F, @ vira %40, # vira %23.
DATABASE_URL=

# Opcional: chave do Resend (re_...). Com ela, "npm run db -- migrate" ativa o aviso
# por e-mail a cada lead novo, guardando a chave no cofre (Vault) do banco.
RESEND_API_KEY=
